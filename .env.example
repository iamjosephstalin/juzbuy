# Application Configuration
NEXT_PUBLIC_APP_NAME=Juzbuy
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Database Configuration (if needed in future)
# DATABASE_URL=postgresql://user:password@localhost:5432/juzbuy

# Payment Gateway (if needed in future)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email Configuration (if needed in future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# WhatsApp Business API
NEXT_PUBLIC_WHATSAPP_PHONE=+919876543210
NEXT_PUBLIC_BUSINESS_NAME=Fresh Groceries Store

# Analytics (optional)
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Security
# NEXTAUTH_URL=https://your-domain.com
# NEXTAUTH_SECRET=your-super-secret-key

# API Rate Limiting (if implemented)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=900000

# Image Storage (if using cloud storage)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret